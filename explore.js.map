    }
  },
  "tweet_2066804703921393850_19": {
    "id": "tweet_2066804703921393850_19",
    "title": "I don't think anyone told me that one of the joys of childhood is never havin...",
    "source_directory": "source-tweets",
    "source_files": ["2066804703921393850.txt"],
    "npc_eligibility": { "genders": ["man"] },
    "start": "line-76",
    "nodes": {
      "line-76": {
        "id": "line-76",
        "speaker": "npc",
