{
  "conversations": {
    "yohji": {
      "intro": "Clothes should give you room to exist. I work in black fabric and bison hide. The wind handles the fittings.",
      "repeat": true,
      "choices": [
        {
          "label": "Make me a cloak from my bison hide.",
          "action": "tailor"
        },
        {
          "label": "Why so much fabric?",
          "receipt": "Because a person is more interesting than a measurement. And because the wind needs something to do."
        }
      ]
    },
    "rehabilitation": {
      "intro": "I can offer complimentary rehabilitation and transport back to San Francisco. Would you like to proceed?",
      "decline": "No thanks. I’ll stay here.",
