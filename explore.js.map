  "tweet_2020276679244148906_5": {
    "id": "tweet_2020276679244148906_5",
    "title": "As we're living through exponential technological takeoff, it's more importan...",
    "source_directory": "source-tweets",
    "source_files": ["2020276679244148906.txt"],
    "start": "line-10",
    "nodes": {
      "line-10": {
        "id": "line-10",
        "speaker": "npc",
        "text": "As we're living through exponential technological takeoff, it's more important than ever to journal and to write down one's impressions as time goes, because otherwise the incremental improvements make it so hard to pin down exactly how something was at a given point in time.",
        "next": "line-11"
      },
      "line-11": {
        "id": "line-11",
        "speaker": "npc",
        "text": "I already regret not recording short YouTube videos of what it was like e.g. programming at the end of 2023 vs. 2024 vs. 2025. These are totally different experiences now.",
        "end": true
      }
    }
  },
