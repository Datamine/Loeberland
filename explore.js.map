      "root": "world.interactions.interactCitizen.node-32",
      "nodes": {
        "world.interactions.interactCitizen.node-32": {
          "id": "world.interactions.interactCitizen.node-32",
          "choices": [
            {
              "id": "world.interactions.interactCitizen.node-32.choice",
              "label": {
                "text": "world.interactions.interactCitizen.choice-34"
              },
              "receipt": "The town’s fine. I see the same neighbors every morning, even when the fog is thick enough that we have to recognize each other by the shopping bags. The beach is usually the quietest place once the wind drops."
            },
            {
              "id": "world.interactions.interactCitizen.node-32.topic.local-knowledge",
              "label": "What’s good today?",
              "receipt": "Whatever the delivery truck can get down the coast road. This morning that meant bread, apples, and six crates of something I was assured would sell better once I’d tried it."
            }
          ],
          "repeat": true,
          "skipIntro": false,
          "intro": "Morning. Come in out of the fog. It’s an early one today. I had to walk halfway down the street to see whether I’d opened the shop sign.",
          "question": "",
          "decline": {
            "text": "world.interactions.interactCitizen.decline-36"
          }
        }
      },
      "sampleValues": {
