{
  "tweet_1664288374897668096_1": {
    "id": "tweet_1664288374897668096_1",
    "title": "Imagine telling a guy in 1900 that a hundred years in the future, you can fly...",
    "source_directory": "source-tweets",
    "source_files": ["1664288374897668096.txt"],
    "start": "line-1",
    "nodes": {
      "line-1": {
        "id": "line-1",
        "speaker": "npc",
        "text": "Imagine telling a guy in 1900 that a hundred years in the future, you can fly across the country in five hours for the price of 4 ham sandwiches.",
        "next": "line-2"
      },
      "line-2": {
        "id": "line-2",
        "speaker": "npc",
        "text": "Is it dangerous? No, it is the safest form of transport.",
        "next": "line-3"
      },
      "line-3": {
        "id": "line-3",
        "speaker": "npc",
        "text": "People must love it! No, it is so commonplace that people whine endlessly.",
        "next": "line-4"
      },
      "line-4": {
        "id": "line-4",
        "speaker": "player",
        "text": "Air travel is incredible. It is probably the best example of a well-regulated highly competitive market economy creating an almost at-cost public utility, ceding oodles and oodles of surplus value to the consumer.",
        "next": "line-5"
      },
      "line-5": {
        "id": "line-5",
        "speaker": "npc",
        "text": "Sometimes I think of this in the context of what people might complain about a few hundred years from now.",
        "next": "line-6"
      },
      "line-6": {
        "id": "line-6",
        "speaker": "player",
        "text": "My immortality drugs are giving me a headache. [rolls eyes]",
        "end": true
      }
    }
  },
  "tweet_1848143438853832840_1": {
    "id": "tweet_1848143438853832840_1",
