  "tweet_2048490877056888951_13": {
    "id": "tweet_2048490877056888951_13",
    "title": "Good literature holds up a mirror to the reader.",
    "source_directory": "source-tweets",
    "source_files": ["2048490877056888951.txt"],
    "start": "line-44",
    "nodes": {
      "line-44": {
        "id": "line-44",
        "speaker": "npc",
        "text": "Good literature holds up a mirror to the reader.",
        "next": "line-45"
      },
      "line-45": {
        "id": "line-45",
        "speaker": "npc",
        "text": "Revisiting a book a few years later always gives you a different experience.",
        "next": "line-46"
      },
      "line-46": {
        "id": "line-46",
        "speaker": "npc",
        "text": "Books like To Kill a Mockingbird are totally different experiences as a teenager vs. as an adult.",
        "next": "line-47"
      },
      "line-47": {
        "id": "line-47",
        "speaker": "player",
        "text": "A lot of political fiction is effective in the same way, as people go through liberal-to-conservative arcs in the courses of their lives.",
        "next": "line-48"
      },
      "line-48": {
        "id": "line-48",
        "speaker": "npc",
        "text": "Good media changes in your perspective at every stage of life, and empathy for the other side as you remember exactly what it was like to agree with the other side years ago.",
        "end": true
      }
    }
  },
  "tweet_2048490877056888951_14": {
