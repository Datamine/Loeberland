# Optional local settings. Copy to deploy/.env.local and uncomment what you need.
# Exported variables take precedence over values in this file.

# Use the Redis address reachable by your selected launcher.
# REDIS_URL=redis://127.0.0.1:6379

# Chat settings for the local game server.
# OAUTH_REQUIRED=False
# UPGRADE_REQUIRED_FOR_SERVER_CHAT=False

# Optional local Google OAuth credentials. Keep real values in .env.local.
# GOOGLE_CHAT_CLIENT_ID=
# GOOGLE_CHAT_CLIENT_SECRET=
# GOOGLE_CHAT_REDIRECT_URI=http://127.0.0.1:8787/auth/google/chat/callback
