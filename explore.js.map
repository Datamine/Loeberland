  "tweet_2025408296463859926_1": {
    "id": "tweet_2025408296463859926_1",
    "title": "It is very sad that Spotify is fundamentally not an app for people who like m...",
    "source_directory": "source-tweets",
    "source_files": ["2025408296463859926.txt"],
    "start": "line-1",
    "nodes": {
      "line-1": {
        "id": "line-1",
        "speaker": "npc",
        "text": "It is very sad that Spotify is fundamentally not an app for people who like music.",
        "next": "line-2"
      },
      "line-2": {
        "id": "line-2",
        "speaker": "npc",
        "text": "Oftentimes I want to search through my Spotify library. It's like 10,000 songs and I want to grab all the ones that I added in the summer of 21.",
        "next": "line-3"
      },
      "line-3": {
        "id": "line-3",
        "speaker": "npc",
        "text": "Can't do that. Maybe I want to grab all the ones with samples from Michael Jackson. Can't do that. Maybe I want to grab all the ones with a particular lyric. Can't do that.",
        "next": "line-4"
      },
      "line-4": {
        "id": "line-4",
        "speaker": "npc",
        "text": "Maybe I want to find all the albums with red cover art. Or find all albums I liked that came out in 2020. Nope!",
        "next": "line-5"
      },
      "line-5": {
        "id": "line-5",
        "speaker": "player",
        "text": "We have AI now. The search and ability to curate could be so good!",
        "next": "line-6"
      },
      "line-6": {
        "id": "line-6",
        "speaker": "npc",
        "text": "If I download all of my Spotify data, I can build all of the search myself. I'm just so disappointed that the Spotify team has never bothered enabling a better search.",
        "end": true
      }
    }
  },
  "tweet_2027640752684339498_1": {
