    "dog-surfing.dogSurfingDialogue.intro-2.yes": {
      "template": "The judges raise their cards! {v0}. {v1} wins this heat!"
    },
    "dog-surfing.dogSurfingDialogue.intro-2.no": {
      "template": "Welcome to the Pacifica Dog Surfing Competition! Biscuit, Nori, and Captain Pickles are heading into the next set."
    },
    "dog-surfing.dogSurfingDialogue.decline-3": {
      "template": "Enjoy the competition"
    },
    "dog-surfing.dogSurfingDialogue.label-5": {
      "template": "What are the judges looking for?"
    },
    "dog-surfing.dogSurfingDialogue.receipt-6": {
      "template": "Balance, style, and commitment. Shaking seawater over the judging panel is a deduction. Looking pleased with yourself is encouraged."
    },
    "dog-surfing.dogSurfingDialogue.label-8": {
      "template": "Who is the favorite?"
    },
    "dog-surfing.dogSurfingDialogue.receipt-9": {
      "template": "Biscuit has experience. Nori has balance. Captain Pickles has a tiny life jacket and absolutely no sense of personal risk."
    },
    "dog-surfing.pacifica-dog-surfing.label": {
      "template": "Pacifica Dog Surfing Competition"
    },
    "dog-surfing.pacifica-dog-surfing.description": {
      "template": "The flags mark the start of the heats. Each dog gets two runs, judged on balance, style, and how much seawater they bring back."
    },
    "dog-surfing.pacifica-dog-surf-trophies.label": {
      "template": "Dog surfing trophies"
    },
    "dog-surfing.pacifica-dog-surf-trophies.description": {
      "template": "Three cups engraved with paw prints. The gold one is almost too big for Captain Pickles to carry."
    },
    "dog-surfing.contestant-0.description": {
      "template": "Biscuit wears red and takes the long, steady line down the wave. An old pro who never has to look at his paws."
    },
    "dog-surfing.contestant-1.description": {
      "template": "Nori wears blue and carves from rail to rail. The only sign that she's concentrating is the very still tail."
    },
    "dog-surfing.contestant-2.description": {
      "template": "Captain Pickles wears yellow and likes to launch clean off the crest. The life jacket has a handle for a reason."
    },
