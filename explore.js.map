      "root": "world.interactions.interactCitizen.node-32",
      "nodes": {
        "world.interactions.interactCitizen.node-32": {
          "id": "world.interactions.interactCitizen.node-32",
          "choices": [
            {
              "id": "world.interactions.interactCitizen.node-32.choice",
              "label": {
                "text": "world.interactions.interactCitizen.choice-34"
              },
              "receipt": "I like it when the beach is quiet enough to hear the water pull back over the stones. Ask someone at the shop when the fog came in and you’ll get a more reliable answer than you will from me."
            },
            {
              "id": "world.interactions.interactCitizen.node-32.topic.local-knowledge",
              "label": "What are you watching for?",
              "receipt": "Give it a minute and watch where the water starts to fold. The first wave can make the whole set look promising. I’ve done enough paddling for one morning to wait and see the second."
            }
          ],
          "repeat": true,
          "skipIntro": false,
          "intro": "Hey. I’m waiting to see what the wind does. Somebody said the best wave of the month came in yesterday. Funny how often that happens on the day I’m working.",
          "question": "",
          "decline": {
            "text": "world.interactions.interactCitizen.decline-36"
          }
        }
      },
