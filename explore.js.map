  "tweet_2048490877056888951_6": {
    "id": "tweet_2048490877056888951_6",
    "title": "Every now and again you run into some community that does not seem interested...",
    "source_directory": "source-tweets",
    "source_files": ["2048490877056888951.txt"],
    "start": "line-20",
    "nodes": {
      "line-20": {
        "id": "line-20",
        "speaker": "npc",
        "text": "Every now and again you run into some community that does not seem interested in status.",
        "next": "line-21"
      },
      "line-21": {
        "id": "line-21",
        "speaker": "npc",
        "text": "They are always interested in status, just not in a form that is legible to you.",
        "next": "line-22"
      },
      "line-22": {
        "id": "line-22",
        "speaker": "npc",
        "text": "Inane comments that read like ordinary conversation are jousting matches of obscure status games and you don't even realize.",
        "next": "line-23"
      },
      "line-23": {
        "id": "line-23",
        "speaker": "player",
        "text": "They ask you whether you prefer canvas or linen and you say both are fine, and the secret doors you did not even know existed become closed to you forever.",
        "end": true
      }
    }
  },
  "tweet_2048490877056888951_7": {
