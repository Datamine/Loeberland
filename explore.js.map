        },
        {
          "id": "service.phone-owned.root.topic.attention",
          "label": "When should I put the phone away?",
          "receipt": "If you’re out exploring and find yourself watching the screen more than the path, that’s a good time. The earnings boost needs the phone equipped. Putting it away also pauses the hitpoint drain from doomscrolling.",
          "repeat": true
        },
        {
          "id": "service.phone-owned.root.topic.campus",
          "label": "Why is the campus round?",
          "receipt": "I used to get to the end of a hallway and turn back toward my desk. Here I keep walking. You get a good look at the courtyard that way, if you remember to look up.",
          "repeat": true
        }
      ],
      "id": "service.phone-owned.root"
    },
    "robotaxi-shop": {
      "intro": {
