    "start": "line-18",
    "nodes": {
      "line-18": {
        "id": "line-18",
        "speaker": "npc",
        "text": "Every day I have to log into like 50 different things and every single one of them wants me to enter a 2FA code and click a link in my email and ENOUGH.",
        "next": "line-19"
      },
      "line-19": {
        "id": "line-19",
        "speaker": "player",
        "text": "This must end.",
        "next": "line-20"
      },
      "line-20": {
        "id": "line-20",
        "speaker": "npc",
        "text": "Let me have an API key and then interact with things programmatically.",
