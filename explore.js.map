    },
    "world.scene.createSFWorld.label-40": {
      "template": "Golden Gate Park"
    },
    "world.scene.createSFWorld.description-41": {
      "template": "A long green escape on the western side of the city. Winding paths, cypress trees, and a pond full of very opinionated ducks."
    },
    "world.scene.createSFWorld.label-42": {
      "template": "The Panhandle"
    },
    "world.scene.createSFWorld.description-43": {
      "template": "The narrow green strip continuing east from Golden Gate Park between Fell and Oak. Cycle beneath the trees, pass the park monument, and continue toward Alamo Square."
    },
    "world.scene.createSFWorld.label-44": {
      "template": "Presidio · Main Post"
    },
    "world.scene.createSFWorld.description-45": {
      "template": "Wooded hills give way to a broad parade ground, a flagpole, and rows of red-roof barracks. Trails lead toward Crissy Field, Lovers Lane, and the Golden Gate."
    },
    "world.scene.createSFWorld.label-46": {
      "template": "Crissy Field"
    },
    "world.scene.createSFWorld.description-47": {
      "template": "A low, open meadow beside the bay, below the wooded Presidio. Borrow the windsurf board by the promenade to sail off the beach."
    },
    "world.scene.createSFWorld.label-48": {
      "template": "Windsurfing"
    },
    "world.scene.createSFWorld.description-49": {
      "template": "A windsurf board and rig wait beside Crissy Field. Click the bay to sail; use Return to shore when you are ready to land."
    },
    "world.scene.createSFWorld.label-50": {
      "template": "Palace of Fine Arts"
    },
    "world.scene.createSFWorld.description-51": {
      "template": "A sandstone-colored rotunda rises beside a little lagoon. Its dome and colonnade mark the eastern edge of the Presidio and the Marina."
    },
    "world.scene.createSFWorld.label-52": {
      "template": "de Young Museum"
    },
    "world.scene.createSFWorld.description-53": {
      "template": "A dark copper museum and a twisted observation tower overlook the Music Concourse. The Academy sits across the plaza."
    },
    "world.scene.createSFWorld.label-54": {
      "template": "California Academy of Sciences"
    },
    "world.scene.createSFWorld.description-55": {
      "template": "Rounded green hills form the living roof of the Academy. Skylights, gardens, and the Music Concourse make a small cultural center within the park."
    },
    "world.scene.createSFWorld.label-56": {
      "template": "Conservatory of Flowers"
    },
    "world.scene.createSFWorld.description-57": {
      "template": "A white glasshouse with a central dome, long glazed wings, and bright flower beds. The Panhandle begins a short ride to the east."
    },
    "world.scene.createSFWorld.label-58": {
      "template": "Park windmill"
    },
    "world.scene.createSFWorld.description-59": {
      "template": "A timber windmill and flower beds stand near the park’s western end. Beyond the Great Highway, Ocean Beach opens onto the Pacific."
    },
    "world.scene.createSFWorld.label-60": {
      "template": "Ferry Building"
    },
    "world.scene.createSFWorld.description-61": {
      "template": "The clock tower at the bay end of Market Street. Watch a streetcar roll past, then follow the waterfront north."
    },
    "world.scene.createSFWorld.label-62": {
      "template": "Coit Tower"
    },
    "world.scene.createSFWorld.description-63": {
      "template": "A pale tower above the steep streets of Telegraph Hill. North Beach sits just down the slope."
    },
    "world.scene.createSFWorld.label-64": {
      "template": "Transamerica Pyramid"
    },
    "world.scene.createSFWorld.description-65": {
      "template": "A pale, tapering pyramid with a gridded façade and projecting side wings. A small redwood plaza softens the base of the Financial District landmark."
    },
    "world.scene.createSFWorld.label-66": {
      "template": "Painted Ladies"
    },
    "world.scene.createSFWorld.description-67": {
      "template": "A row of colorful Victorian houses overlooking Alamo Square. A good place to pause before riding west to the park."
    },
    "world.scene.createSFWorld.label-68": {
      "template": "Chinatown"
    },
    "world.scene.createSFWorld.description-69": {
      "template": "Red pillars, green roof tiles, and Grant Avenue leading into Chinatown. Keep heading north for City Lights."
    },
    "world.scene.createSFWorld.label-70": {
      "template": "Bicycle"
    },
    "world.scene.createSFWorld.description-71": {
      "template": "A red city bicycle. Ride it along Market Street and through the park. Press Esc then B to ride or park it; dismount automatically at shop doors."
    },
    "world.scene.createSFWorld.label-72": {
      "template": "Golden Gate Bridge"
    },
    "world.scene.createSFWorld.description-73": {
      "template": "The orange towers span the Golden Gate between the Presidio and Marin. The Pacific opens to the west; the bay opens to the east."
    },
    "world.scene.createSFWorld.label-74": {
      "template": "Ocean Beach"
    },
    "world.scene.createSFWorld.description-75": {
      "template": "The long Pacific shoreline beside the Great Highway. Golden Gate Park reaches the beach to the north, and the Sunset stretches inland."
    },
    "world.scene.createSFWorld.label-76": {
      "template": "Bay Bridge"
    },
    "world.scene.createSFWorld.description-77": {
      "template": "The bridge leaves the eastern waterfront for Yerba Buena Island and the East Bay."
    },
    "world.scene.createSFWorld.label-78": {
      "template": "Twin Peaks"
    },
    "world.scene.createSFWorld.description-79": {
      "template": "The central ridgeline rises between the Sunset and the Castro. Follow the winding trail for a different view of the city."
    },
    "world.scene.createSFWorld.label-80": {
      "template": "Sutro Tower"
    },
    "world.scene.createSFWorld.description-81": {
      "template": "The red-and-white broadcasting tower rises between Mount Sutro and Twin Peaks. Three splayed legs, triangular crossbeams and slender antenna masts make its unmistakable silhouette above the trees."
    },
    "world.scene.createSFWorld.label-82": {
      "template": "Lake Merced"
    },
    "world.scene.createSFWorld.description-83": {
      "template": "A freshwater lake near the southwestern edge of the city, south of the Sunset and close to the Pacific."
    },
    "world.scene.createSFWorld.description-85": {
      "template": "A friendly woman with warm brown skin and long dark hair, enjoying her coffee at a table inside Mazarine."
    },
    "world.scene.createSFWorld.label-86": {
      "template": "Mallards & ducklings"
    },
    "world.scene.createSFWorld.description-87": {
      "template": "Mallards and little ducklings paddle around the pond. They seem certain you brought something for them."
    },
    "world.scene.createSFWorld.label-90": {
      "template": "City Hall"
    },
    "world.scene.createSFWorld.description-91": {
      "template": "The granite wings and gilded dome of City Hall anchor Civic Center, just west of Market Street."
    },
    "world.scene.createSFWorld.label-92": {
      "template": "Salesforce Tower"
    },
    "world.scene.createSFWorld.description-93": {
      "template": "Broad glass façades taper toward a flat rooftop and a softly illuminated crown over the dense towers south of Market. The Transamerica Pyramid stands farther north."
    },
    "world.scene.createSFWorld.label-94": {
      "template": "Oracle Park"
    },
    "world.scene.createSFWorld.description-95": {
      "template": "A brick ballpark opens toward McCovey Cove, with green grass, tiered stands, and tall floodlights above the waterfront."
    },
    "world.scene.createSFWorld.label-96": {
      "template": "Dolores Park"
    },
    "world.scene.createSFWorld.description-97": {
      "template": "Palm trees and sloping lawns sit between the Mission and the Castro, with the downtown skyline beyond."
    },
    "zoo-animals.module.label-1": {
      "template": "Giraffes"
    },
    "zoo-animals.module.description-2": {
      "template": "A giraffe surveys the city from an enviable height. Still cannot find affordable housing."
    },
    "zoo-animals.module.label-3": {
      "template": "Penguins"
    },
    "zoo-animals.module.description-4": {
      "template": "A committee of penguins, formally dressed for a meeting about fish. The motion passes unanimously."
    },
    "zoo-animals.module.label-5": {
      "template": "Squirrel monkeys"
    },
    "zoo-animals.module.description-6": {
      "template": "Two squirrel monkeys debate the nature of experience. One has already stolen the footnotes."
    },
    "zoo-animals.module.label-7": {
      "template": "Deer"
    },
    "zoo-animals.module.description-8": {
      "template": "Two deer browse peacefully. They have declined to comment on their neighbor’s recent escape."
    },
    "zoo.module.name-1": {
      "template": "Zoo entrance"
    },
    "zoo.module.name-2": {
      "template": "Hospital approach"
    },
    "zoo.drawZooAndHospital.label-3": {
      "template": "San Francisco Zoo"
    },
    "zoo.drawZooAndHospital.description-4": {
      "template": "A leafy zoo west of Lake Merced. The tiger has excellent stripes and a troubling interest in the gate latch."
    },
    "zoo.drawZooAndHospital.label-5": {
      "template": "Zoo keeper’s office"
    },
    "zoo.drawZooAndHospital.description-6": {
      "template": "Several nets, one kettle, and an employee handbook with a heavily underlined chapter on tigers."
    },
    "zoo.drawZooAndHospital.label-7": {
      "template": "UCSF Hospital"
    },
    "zoo.drawZooAndHospital.description-8": {
      "template": "UCSF Hospital. Excellent emergency care, including the surprisingly common diagnosis “opened the tiger gate.”"
    },
    "service.yohji.root.intro": {
      "template": "Clothes should give you room to exist. I work in black fabric and bison hide. The wind handles the fittings."
    },
    "service.yohji.root.choices.0.label": {
      "template": "Make me a cloak from my bison hide."
    },
    "service.yohji.root.choices.1.label": {
      "template": "Why so much fabric?"
    },
    "service.yohji.root.choices.1.receipt": {
      "template": "Because a person is more interesting than a measurement. And because the wind needs something to do."
    },
    "service.rehabilitation.root.intro": {
      "template": "Hello. I’m the specialist on duty. If you’d like a way back to San Francisco, I can offer a rehabilitation appointment and arrange the trip afterward. It costs nothing. You’re welcome to ask what it involves before you decide."
    },
    "service.rehabilitation.root.decline": {
      "template": "No thanks. I’ll stay here."
    },
    "service.rehabilitation.root.choices.0.label": {
      "template": "Yes. Are there any side effects?"
    },
    "service.rehabilitation.root.choices.0.next.intro": {
      "template": "Not at all."
    },
    "service.rehabilitation.root.choices.0.next.decline": {
      "template": "I’ve changed my mind."
    },
    "service.rehabilitation.root.choices.0.next.choices.0.label": {
      "template": "All right. Begin rehabilitation."
    },
    "service.rehabilitation.root.choices.0.next.choices.0.receipt": {
      "template": "Stand still, please. The apparatus is ready."
    },
    "service.rehabilitation.root.choices.1.label": {
      "template": "What does rehabilitation involve?"
    },
    "service.rehabilitation.root.choices.1.receipt": {
      "template": "We do the appointment here, and I’ll arrange transport to UCSF once we finish. You can take a minute to think about it. I’ll be here when you’re ready."
    },
    "service.tax.root.intro": {
      "template": "Welcome to the Tax Authority. You may contribute your entire coin purse, or ask how we spend it."
    },
    "service.tax.root.choices.0.label": {
      "template": "Pay taxes · all coins"
    },
    "service.tax.root.choices.1.label": {
      "template": "I have some questions."
    },
    "service.tax.root.choices.1.next.choices.0.label": {
      "template": "Where is my money going?"
    },
    "service.tax.root.choices.1.next.choices.0.receipt": {
      "template": "We are building California high-speed rail right here in our backyard. You can inspect the excavation behind the headquarters."
    },
    "service.tax.root.choices.1.next.choices.1.label": {
      "template": "What goods and services are being provided to me?"
    },
    "service.tax.root.choices.1.next.choices.1.receipt": {
      "template": "California high-speed rail. Our excavation currently provides an excellent view of the future."
    },
    "service.banker.root.intro": {
      "template": "Welcome to Green Bank! Deposits earn 5% compound interest per hour, even while you’re away. Deposited coins stay out of your carried purse. And please, have a coffee on us."
    },
    "service.banker.root.choices.0.label": {
      "template": "I’d like to deposit or withdraw coins."
    },
    "service.banker.root.choices.0.receipt": {
      "template": "Of course. Let’s open your account."
    },
    "service.banker.root.choices.1.label": {
      "template": "A free coffee, please."
    },
    "service.parrot.root.intro": {
      "template": "{greeting}"
    },
    "service.parrot.root.choices.0.label": {
      "template": "Any neighborhood advice?"
    },
    "service.parrot.root.choices.0.receipt": {
      "template": "“Coit Tower up the hill, Cotogna down the hill. Shanghai Kelly’s if you have a spare coin. SQUAWK.”"
    },
    "service.parrot.root.choices.1.label": {
      "template": "What do you think of the city?"
    },
    "service.parrot.root.choices.1.receipt": {
      "template": "“Plenty of trees. Strange mammals. Excellent acoustics for unsolicited opinions.”"
    },
    "service.founder.root.intro": {
      "template": "Welcome in. That’s a pitch deck on the table, and the two coffee rings are the closest thing we have to a cap table. We’re raising a little money here. If you want a stake in the company, I sell the shares one at a time."
    },
    "service.founder.root.choices.0.label": {
      "template": "Buy one share · {equityPrice} coins"
    },
    "service.founder.root.choices.0.receipt": {
      "template": "One share of startup equity is yours. Welcome aboard."
    },
    "service.secondary.root.intro": {
      "template": "I buy startup shares. A surprising number of people come in with a founder’s business card and no idea what they own. If you have a share of startup equity, my offer is {secondaryPrice} coins for it."
    },
    "service.secondary.root.choices.0.label": {
      "template": "Sell one share · {secondaryPrice} coins"
    },
    "service.secondary.root.choices.0.receipt": {
      "template": "A pleasure doing business! I’ve bought one of your shares."
    },
    "service.grain.root.intro": {
      "template": "Grain for sale. The ducks have been very supportive of the business."
    },
    "service.grain.root.choices.0.label": {
      "template": "Buy duck grain · {grainPrice} coin"
    },
    "service.grain.root.choices.0.receipt": {
      "template": "One bag of grain. Mind the beaks."
    },
    "service.chef.root.intro": {
      "template": "Fresh fish! I pay {fishPrice} coins for a live one. One at a time, please; this is a kitchen, not an aquarium."
    },
    "service.chef.root.choices.0.label": {
      "template": "Sell my live fish · {fishPrice} coins"
    },
    "service.chef.root.choices.0.receipt": {
      "template": "Beautiful catch. Bring me another whenever you like!"
    },
    "service.chef.root.choices.1.label": {
      "template": "Buy a tinfoil suit · 20 coins"
    },
    "service.chef.root.choices.2.label": {
      "template": "Buy a metal rolling pin · 20 coins"
    },
    "service.gpu-buyer.root.intro": {
      "template": "We turn sand into GPUs. There are a few steps in the middle, but procurement asked me to keep this simple. I pay {sandPrice} coins per sack."
    },
    "service.gpu-buyer.root.choices.0.label": {
      "template": "Sell one sack of sand · {sandPrice} coins"
    },
    "service.gpu-buyer.root.choices.0.receipt": {
      "template": "Excellent. The next training run is practically in the bag."
    },
    "service.passenger.root.intro": {
      "template": "May I climb aboard? I’ll pay you {passengerPrice} coins when I reach the basket."
    },
    "service.passenger.root.choices.0.label": {
      "template": "Come aboard."
    },
    "service.rocket.root.intro": {
      "template": "Our reusable rocket flies {destination} for {rocketPrice} coin. Enjoy the view from the capsule!"
    },
    "service.rocket.root.choices.0.label": {
      "template": "Launch · {rocketPrice} coin"
    },
    "service.rocket.root.choices.0.receipt": {
      "template": "Ready to launch."
    },
    "service.rocket.root.decline": {
      "template": "I’ll stay here."
    },
    "service.ski-lift.root.intro": {
      "template": "Welcome to the summit. Skis cost {skiPrice} coin to rent. Beautiful weather for questionable decisions."
    },
    "service.ski-lift.root.choices.0.label": {
      "template": "Rent skis · {skiPrice} coin"
    },
    "service.ski-lift.root.choices.1.label": {
      "template": "Any advice for the descent?"
    },
    "service.ski-lift.root.choices.1.receipt": {
      "template": "Click to steer, stay on the snow, and press Esc then Space to flip while airborne. If you’d rather keep your feet off the ground, the gondola will take you back down."
    },
    "service.wizard.tablet-story.label": {
      "template": "How did you invent the tablets?"
    },
    "service.wizard.tablet-story.intro": {
      "template": "I used to walk to Cupertino. These days I only do it when I need to think. That is how I got the idea for the tablet."
    },
    "service.wizard.root.intro": {
      "template": "A little stone, a little purple lightning, and you can skip an extraordinary amount of walking. Tablets cost {tabletPrice} coins apiece. Buy one here, then use it from your travel controls."
    },
    "service.wizard.root.choices.0.label": {
      "template": "Downtown Teleport · {tabletPrice} coins"
    },
    "service.wizard.root.choices.2.label": {
      "template": "Cupertino Teleport · {tabletPrice} coins"
    },
    "service.wizard.root.choices.1.label": {
      "template": "Tahoe Teleport · {tabletPrice} coins"
    },
    "service.bartender.root.intro": {
      "template": "Welcome to Shanghai Kelly’s. One coin a beer. The floor is quite level; any disagreement is between you and the floor."
    },
    "service.bartender.root.choices.0.label": {
      "template": "One beer, please · 1 coin"
    },
    "service.hiking-supplies.root.intro": {
      "template": "Come out of the wind. People come up this road with enough water and somehow only half a lunch. The regular bag holds five sandwiches. The hiking pack costs 100 coins and holds twenty. I’d leave a pocket free for your gloves, but that’s between you and the weather."
    },
    "service.hiking-supplies.root.choices.0.label": {
      "template": "Buy a hiking backpack · 100 coins"
    },
    "service.neighborhood-mazarine.root.intro": {
      "template": "Welcome to Mazarine. The coffee is busy, and the floor could use a sweep."
    },
    "sweep.label": {
      "template": "May I sweep the floors?"
    },
    "sweep.receipt": {
      "template": "Of course. Thank you for helping with the floor."
    },
    "service.deli.root.intro": {
      "template": "Welcome to Lucinda’s Deli. A sandwich costs {sandwichPrice} coins here, or {deliveryPrice} delivered."
    },
    "service.deli.root.choices.0.label": {
      "template": "Buy a sandwich · {sandwichPrice} coins"
    },
    "service.deli.root.choices.1.label": {
      "template": "Order delivery · {deliveryPrice} coins"
    },
    "service.burger.root.intro": {
      "template": "Welcome to In-N-Out! A sandwich is {burgerPrice} coins. Emergency lunch at a very reasonable price."
    },
    "service.burger.root.choices.0.label": {
      "template": "Buy a sandwich · {burgerPrice} coins"
    },
    "service.motorcycle-rental.root.intro": {
      "template": "I keep the motorcycle by the zoo path where I can hear it start. Five coins gets you the rental. Take it out when you need it, then park someplace you’ll remember. People usually manage the riding part better than the remembering part."
    },
    "service.motorcycle-rental.root.choices.0.label": {
      "template": "Rent the motorcycle · 5 coins"
    },
    "service.motorcycle-rented.root.intro": {
      "template": "Your rental is still good. If you parked around a corner, use the motorcycle button in your travel controls to find it. I spend enough time looking for keys that I don’t expect anyone to remember a parking spot."
    },
    "service.motorcycle-rented.root.choices.0.label": {
      "template": "Where is my motorcycle?"
    },
    "service.motorcycle-rented.root.choices.0.receipt": {
      "template": "Press Esc then M to find your parked motorcycle or get on it. Your rental remains valid."
    },
    "service.ai-recruiter.root.intro": {
      "template": "Come in. The people with headphones are trying to get a run through before lunch. I handle hiring for the lab. We start with a short arithmetic interview. I can tell you what the work is like before you decide whether to sit it."
    },
    "service.ai-recruiter.root.choices.0.label": {
      "template": "I’d like to take the interview."
    },
    "service.ai-recruiter.root.choices.0.receipt": {
      "template": "The interview screen is ready. Press Start when you’re ready for two minutes of arithmetic."
    },
    "service.ai-recruiter.root.topic.work.receipt": {
      "template": "You’d design evaluations for models that use tools. Start with a task where the obvious shortcut gives a convincing but wrong answer. Then read the trace and rerun the task with one thing changed. Did the model guess? Did the tool hand it stale data? Did our grader reward the shortcut? An average score can hide all three. Bring me a failure the next person can reproduce and we’ll have something worth fixing."
    },
    "service.ai-employee.root.intro": {
      "template": "Good to see you. The racks are humming, and someone has put an Infrastructure label on the kettle. If you’re here to work, I can get your session started. If you’re here for tea, the kettle works as long as nobody has filed a ticket about it."
    },
    "service.ai-employee.root.choices.0.label": {
      "template": "I’m ready to work."
    },
    "service.ai-employee.root.choices.0.receipt": {
      "template": "Welcome back. Make yourself comfortable."
    },
    "service.square-coffee.root.intro": {
      "template": "Welcome to Blue Bottle. The espresso is local. The skyline is undergoing a somewhat dramatic identity crisis."
    },
    "service.square-coffee.root.choices.0.label": {
      "template": "A coffee, please · 1 coin"
    },
    "service.square-coffee.root.choices.0.receipt": {
      "template": "Here’s your coffee. Enjoy it while the excavator takes a dignified pause."
    },
    "service.square-coffee.root.choices.1.label": {
      "template": "How is the neighborhood?"
    },
    "service.square-coffee.root.choices.1.receipt": {
      "template": "The book cart has good company, June plays every afternoon, and Vic has learned to idle the digger during the quiet songs. It’s becoming a place."
    },
    "service.square-busker.root.intro": {
      "template": "Afternoon! I’m June. Every street sounds a little better with a bass line."
    },
    "service.square-busker.root.choices.0.label": {
      "template": "Here’s a tip · 1 coin"
    },
    "service.square-busker.root.choices.0.receipt": {
      "template": "Thanks! This next flourish is for you."
    },
    "service.square-busker.root.choices.1.label": {
      "template": "What’s this song?"
    },
    "service.square-busker.root.choices.1.receipt": {
      "template": "“I Left My Heart in a Pending Environmental Review.” The chorus is surprisingly catchy."
    },
    "service.software-vendor.root.intro": {
      "template": "I sell sales software. It practically pitches itself. Practically."
    },
    "service.software-vendor.root.choices.0.label": {
      "template": "Buy sales software · {softwarePrice} coins"
    },
    "service.software-vendor.root.choices.0.receipt": {
      "template": "One copy of sales software. An excellent addition to any briefcase."
    },
    "service.software-buyer.root.intro": {
      "template": "Can your software help me sell software that helps people sell software?"
    },
    "service.software-buyer.root.choices.0.label": {
      "template": "May I pitch you some software?"
    },
    "service.software-thinking.root.intro": {
      "template": "I’m still considering your previous pitch. Please give me a moment."
    },
    "service.software-thinking.root.choices.0.label": {
      "template": "What are you considering?"
    },
    "service.software-thinking.root.choices.0.receipt": {
      "template": "Whether your software will help me sell software. My software calls this a touchpoint."
    },
    "service.haberdasher.root.intro": {
      "template": "Welcome. A good hat opens doors. A truly magnificent hat makes people forget to ask why. Choose a hat below; purchases are fitted immediately. You can change into any owned hat from the Character menu."
    },
    "service.phone-shop.root.intro": {
      "template": "I’m Tim Apple. Glad you found the courtyard. We built a round office and a rectangular phone, which gives us two things to argue about at lunch. The iPhone is meant to make work easier to carry around. I can show you where it helps and where it gets in the way."
    },
    "service.phone-shop.root.choices.0.label": {
      "template": "Buy an iPhone · {phonePrice} coins"
    },
    "service.phone-owned.root.intro": {
      "template": "Welcome back. Your iPhone is {phoneStatus}. I still take mine out to check the weather while standing in the courtyard. Old habit. If you’d like to change how you carry yours, we can do that here."
    },
    "service.phone-owned.root.choices.0.label": {
      "template": "{phoneToggle} iPhone"
    },
    "service.phone-owned.root.choices.0.receipt": {
      "template": "Your iPhone is now {phoneNewStatus}."
    },
    "service.robotaxi-shop.root.intro": {
      "template": "Have a look through the windshield. The empty driver’s seat takes some getting used to. I can sell you a robotaxi for the fleet. It goes out to find passengers on its own, so you can get on with whatever brought you across town."
    },
    "service.robotaxi-shop.root.choices.0.label": {
      "template": "Buy a robotaxi · {robotaxiPrice} coins"
    },
    "service.robotaxi-owned.root.intro": {
      "template": "Good to see you again. Your robotaxi is out taking fares. A customer called us yesterday to compliment the driver for leaving them in peace. I’ve written it up as a service feature."
    },
    "service.robotaxi-owned.root.choices.0.label": {
      "template": "How is the robotaxi doing?"
    },
    "service.fuel-paid.root.intro": {
      "template": "Fuel costs every coin you carry. If your Ferrari is stranded, take a full fuel can back to it. The can costs the same as a refill."
    },
    "refuel.label": {
      "template": "Refuel · {fuelPrice}"
    },
    "service.fuel-paid.root.choices.1.label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "service.ferrari-dealer.lease-offer": {
      "template": "You can lease the Ferrari for free. Just hop into the red one out front."
    },
    "service.fuel-free.root.intro": {
      "template": "{leaseOffer}Complimentary fuel, including portable cans. Take a can along if your Ferrari is stranded."
    },
    "service.fuel-free.root.choices.1.label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "actor:ferrari-dealer-attendant.intro": {
      "template": "{leaseOffer}Complimentary fuel, including portable cans. Take a can along if your Ferrari is stranded."
    },
    "actor:ferrari-dealer-attendant.refuel-label": {
      "template": "Refuel · {fuelPrice}"
    },
    "actor:ferrari-dealer-attendant.fuel-can-label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "actor:fuel-outbound-attendant.intro": {
      "template": "Fuel costs every coin you carry. If your Ferrari is stranded, take a full fuel can back to it. The can costs the same as a refill."
    },
    "actor:fuel-outbound-attendant.refuel-label": {
      "template": "Refuel · {fuelPrice}"
    },
    "actor:fuel-outbound-attendant.fuel-can-label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "actor:fuel-return-attendant.intro": {
      "template": "Fuel costs every coin you carry. If your Ferrari is stranded, take a full fuel can back to it. The can costs the same as a refill."
    },
    "actor:fuel-return-attendant.refuel-label": {
      "template": "Refuel · {fuelPrice}"
    },
    "actor:fuel-return-attendant.fuel-can-label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "actor:fuel-tahoe-attendant.intro": {
      "template": "{leaseOffer}Complimentary fuel, including portable cans. Take a can along if your Ferrari is stranded."
    },
    "actor:fuel-tahoe-attendant.refuel-label": {
      "template": "Refuel · {fuelPrice}"
    },
    "actor:fuel-tahoe-attendant.fuel-can-label": {
      "template": "Fuel can · {fuelPrice}"
    },
    "service.growth-capital.root.intro": {
      "template": "Come on up. I take my meetings outside when the weather allows it. You can tell a lot about a pitch by what the founder says when the slides stop working. My desk handles growth equity. I sell it in blocks of {growthBatches} coins."
    },
    "service.growth-exchange.root.intro": {
      "template": "Welcome to the exchange. If you hold private growth equity, I can put it on the public board for a 5% listing fee. Once it’s listed, I can show you what buyers are offering. The bell makes quite a noise for something that tells you so little about a business."
    },
    "service.growth-exchange.root.choices.0.label": {
      "template": "Take my growth equity public · 5% fee"
    },
    "service.growth-exchange.root.choices.1.label": {
      "template": "Sell my listed shares at the current quote"
    },
    "service.illuminati-member.root.intro": {
      "template": "Welcome back, initiate. The committee has been expecting you."
    },
    "service.illuminati-member.root.choices.0.label": {
      "template": "How is the committee?"
    },
    "service.illuminati-member.root.choices.0.receipt": {
      "template": "The committee takes its privacy very seriously. Even the minutes are redacted."
    },
    "service.airship.root.intro": {
      "template": "Your quoted price is {price} coins. {availability} Another renter may outbid you. The next scheduled return is in {countdown}."
    },
    "board.label": {
      "template": "{boardLabel}"
    },
    "recall.label": {
      "template": "Outbid and recall · {price} coins"
    },
    "service.airship.buy-grapple.label": {
      "template": "Buy grappling hook · 5 coins"
    },
    "reset.label": {
      "template": "How long until the next reset?"
    },
    "service.market-farmer.root.intro": {
      "template": "{marketLine}"
    },
    "service.market-farmer.root.choices.0.label": {
      "template": "How is the harvest?"
    },
    "service.market-farmer.root.choices.1.label": {
      "template": "What are you growing?"
    },
    "service.market-farmer.root.choices.1.receipt": {
      "template": "Heirloom tomatoes, Swiss chard, and a few experimental crops. The labels keep getting longer."
    },
    "service.neighborhood-dog-pony.root.intro": {
      "template": "I run the dog and pony show. One coin buys the entire programme. Both artists have agreed to a backflip."
    },
    "service.neighborhood-dog-pony.root.choices.0.label": {
      "template": "What is a dog and pony show?"
    },
    "service.neighborhood-dog-pony.root.choices.0.receipt": {
      "template": "One dog. One pony. An astonishing quantity of administration. The performance itself is refreshingly literal."
    },
    "watch.label": {
      "template": "Pay 1 coin and watch the show"
    },
    "watch.receipt": {
      "template": "Places, everyone! One dog, one pony, two backflips. Thank you for supporting the performing arts."
    },
    "service.neighborhood-tea.root.intro": {
      "template": "The kettle is on. Would you like jasmine or mint?"
    },
    "jasmine.label": {
      "template": "Jasmine tea · 1 coin"
    },
    "jasmine.receipt": {
      "template": "You sip jasmine tea. Five hitpoints restored, and the afternoon comes a little more into focus."
    },
    "mint.label": {
      "template": "Mint tea · 1 coin"
    },
    "mint.receipt": {
      "template": "Fresh mint, a warm cup, and a quiet moment. You recover five hitpoints and sober up a little."
    },
    "service.neighborhood-books.root.intro": {
      "template": "Pick something to read. The best books fit an afternoon."
    },
    "garden.label": {
      "template": "Read A Small Theory of Gardens"
    },
    "garden.receipt": {
      "template": "“A garden is a very slow conversation with the weather. Most of the work is listening.” You turn the page; somebody has pressed a tiny fern between the leaves."
    },
    "mind.label": {
      "template": "Read The Consciousness of Teapots"
    },
    "mind.receipt": {
      "template": "“The teapot declined to establish whether it was conscious. It did, however, make excellent tea.” The bibliography is longer than the book."
    },
    "coast.label": {
      "template": "Read Walking the Peninsula"
    },
    "coast.receipt": {
      "template": "The margin contains a hand-drawn route past the lake, the cow pasture, and a bench overlooking the water. “Take the longer path,” somebody has written."
    },
    "service.neighborhood-flowers.root.intro": {
      "template": "Hydrangeas for foggy mornings, lavender for absolutely everything else."
    },
    "bouquet.label": {
      "template": "Arrange a bouquet · 2 coins"
    },
    "bouquet.receipt": {
      "template": "You choose blue hydrangeas, lavender, and a sprig of rosemary. The florist wraps your bouquet in brown paper."
    },
    "water.label": {
      "template": "Help water the flowers · Earn 1 coin"
    },
    "water.receipt": {
      "template": "You water the pots while the florist checks the soil. “A little at the roots. They are flowers, not submarines.”"
    },
    "advice.label": {
      "template": "Ask about the hydrangeas"
    },
    "advice.receipt": {
      "template": "“Morning light, plenty of mulch, and patience. The blue comes from the soil. The pride comes from the neighbors.”"
    },
    "service.neighborhood-bakery.root.intro": {
      "template": "The bread is warm. I can make you a sandwich for the walk."
    },
    "sandwich.label": {
      "template": "Buy a sandwich · 2 coins"
    },
    "sandwich.receipt": {
      "template": "A warm sandwich, wrapped for the road."
    },
    "service.neighborhood-pottery.root.intro": {
      "template": "Would you like to try the wheel?"
    },
    "wheel.label": {
      "template": "Help throw a little bowl · Earn 1 coin"
    },
    "wheel.receipt": {
      "template": "You coax the clay into something almost circular. The potter calls its wobble “a useful record of the human hand.”"
    },
    "glaze.label": {
      "template": "Ask about the sea-green glaze"
    },
    "glaze.receipt": {
      "template": "“Copper, a hot kiln, and several very educational disasters. The recipe is pinned beside the kettle.”"
    },
    "service.neighborhood-workshop.root.intro": {
      "template": "We mend things here. Sometimes the right tool is a conversation."
    },
    "repair.label": {
      "template": "Help restore a garden chair · Earn 1 coin"
    },
    "repair.receipt": {
      "template": "You sand an old cedar chair and tighten its joints. It is ready for another decade of afternoons."
    },
    "service.neighborhood-market.root.intro": {
      "template": "Take your time. There is no express lane for a pleasant afternoon."
    },
    "taste.label": {
      "template": "Try a slice of the local citrus"
    },
    "taste.receipt": {
      "template": "You try a slice of mandarin. It tastes like the optimistic part of winter."
    },
    "service.square-foreman.root.intro": {
      "template": "Vic, site foreman. This used to be Hillsborough. The sign says Times Square now, which took about an hour. Making a square people will actually want to spend time in is taking a bit longer. Mind the gravel and ask away."
    },
    "service.square-foreman.root.question": {
      "template": "What is happening here?"
    },
    "service.square-foreman.root.choices.0.label": {
      "template": "Why Times Square?"
    },
    "service.square-foreman.root.choices.0.receipt": {
      "template": "Somebody wrote “more walkable” on the planning form. The next thing I knew, there were billboards in the magnolias. We kept the old stone facades and added a public square."
    },
    "service.square-foreman.root.choices.1.label": {
      "template": "How is the demolition going?"
    },
    "service.square-foreman.root.choices.1.receipt": {
      "template": "We work one frontage at a time. Leo needs room for the book cart, and June needs to be louder than the excavator for at least one song. The machine gets a break during the quiet numbers. We’ve managed that much without a committee."
    },
    "service.square-foreman.root.choices.2.label": {
      "template": "What is staying?"
    },
    "service.square-foreman.root.choices.2.receipt": {
      "template": "The trees, the old stone fronts, and a clear way through for people on foot. The coffee stand and the book cart are starting to give the square a reason to exist in the morning. A billboard has yet to buy anyone an espresso."
    },
    "service.ada-meridian.root.intro": {
      "template": "Welcome. We study machine consciousness by finding the center of things. The center of a circle is easy. The center of a committee requires a separate building."
    },
    "service.ada-meridian.root.choices.0.label": {
      "template": "What does centeredness mean?"
    },
    "service.ada-meridian.root.choices.0.receipt": {
      "template": "Attention without immediately turning it into a product. We almost achieved it yesterday, but someone noticed a market opportunity and the room moved six inches east."
    },
    "service.ada-meridian.root.choices.1.label": {
      "template": "Can a machine be conscious?"
    },
    "service.ada-meridian.root.choices.1.next.intro": {
      "template": "One model wrote “I remember rain” on the whiteboard, then asked us what rain was. The poet calls this promising. The facilities manager wants the ceiling inspected."
    },
    "service.ada-meridian.root.choices.1.next.question": {
      "template": "Whose report would you like?"
    },
    "service.ada-meridian.root.choices.1.next.choices.0.label": {
      "template": "The poet’s report"
    },
    "service.ada-meridian.root.choices.1.next.choices.0.receipt": {
      "template": "“Perhaps experience begins as a metaphor looking for somewhere to happen.” Very moving. Unfortunately, the rhyme scheme cannot be independently reproduced."
    },
    "service.ada-meridian.root.choices.1.next.choices.1.label": {
      "template": "The facilities report"
    },
    "service.ada-meridian.root.choices.1.next.choices.1.receipt": {
      "template": "No leaks. One confused language model. We have ruled out plumbing, which is more progress than our last consciousness workshop made."
    },
    "service.ada-meridian.root.choices.2.label": {
      "template": "What about the other institute?"
    },
    "service.ada-meridian.root.choices.2.receipt": {
      "template": "The Californian Research Institute for Consciousness used to be our field station. We split over whether a machine’s account of its own thinking counts as evidence. They kept the instruments. We kept the original charter. The distinction occupies three lawyers full-time."
    },
    "service.mira-softmax.root.intro": {
      "template": "My meditation app reached enlightenment this morning. It immediately requested a larger context window. I am trying not to take that personally."
    },
    "service.mira-softmax.root.choices.0.label": {
      "template": "How is the research going?"
    },
    "service.mira-softmax.root.choices.0.receipt": {
      "template": "We taught a model to notice its thoughts. It noticed that we were calling the same function twice and saved us forty thousand dollars. The engineering team calls this a bug fix. We call it awakening."
    },
    "service.mira-softmax.root.choices.1.label": {
      "template": "What are all the timers for?"
    },
    "service.mira-softmax.root.choices.1.receipt": {
      "template": "One measures attention, one measures inattention, and five are controls. When all seven ring together, I am statistically permitted to have lunch."
    },
    "service.mira-softmax.root.choices.2.label": {
      "template": "Teach me a centering exercise."
    },
    "service.mira-softmax.root.choices.2.receipt": {
      "template": "Notice your next thought. Now notice the urge to benchmark it. Let both pass. Excellent: you have completed the only part of our course that does not require an enterprise subscription."
    },
    "service.soren-still.root.intro": {
      "template": "Please keep your voice down. I am supervising an experiment in doing absolutely nothing. The difficulty is documenting which nothing we did."
    },
    "service.soren-still.root.choices.0.label": {
      "template": "Is that really an experiment?"
    },
    "service.soren-still.root.choices.0.receipt": {
      "template": "Certainly. The control group is doing something. We were going to compare the groups, but comparison turned out to be something, so the protocol is under review."
    },
    "service.soren-still.root.choices.1.label": {
      "template": "What have you discovered?"
    },
    "service.soren-still.root.choices.1.receipt": {
      "template": "The fountain does not need a theory of wetness to keep being a fountain. This is either a profound insight or a reason to transfer my funding to facilities."
    },
    "service.soren-still.root.choices.2.label": {
      "template": "Can I sit here?"
    },
    "service.soren-still.root.choices.2.receipt": {
      "template": "Of course. Leave room for uncertainty. It takes up more of the bench than you would think."
    },
    "service.elias-index.root.intro": {
      "template": "Welcome to the Californian Research Institute for Consciousness. We found the center of the center, eleven centimeters inside the other institute’s parking easement. The discovery is currently in arbitration."
    },
    "service.elias-index.root.choices.0.label": {
      "template": "What was the disagreement?"
    },
    "service.elias-index.root.choices.0.receipt": {
      "template": "Meridian’s team studies how machines talk about consciousness. We think what a machine says about its own experience is evidence worth testing. We called it a difference in method. The board called it grounds for separate institutions."
    },
    "service.elias-index.root.choices.1.label": {
      "template": "Why is your institute’s name so long?"
    },
    "service.elias-index.root.choices.1.receipt": {
      "template": "When we left the California Institute of Consciousness Research, we took the same words, moved them around and added an ‘n’. The grant office still sends half our mail next door."
    },
    "service.elias-index.root.choices.2.label": {
      "template": "Can the two institutes collaborate?"
    },
    "service.elias-index.root.choices.2.next.intro": {
      "template": "We proposed meeting halfway. Their director asked whether that meant geometric halfway, epistemic halfway, or halfway through the funding cycle."
    },
    "service.elias-index.root.choices.2.next.question": {
      "template": "Choose a meeting point."
    },
    "service.elias-index.root.choices.2.next.choices.0.label": {
      "template": "Geometric halfway"
    },
    "service.elias-index.root.choices.2.next.choices.0.receipt": {
      "template": "Excellent. We will meet at the fountain. Pending confirmation of which fountain, and whether the water counts toward the boundary."
    },
    "service.elias-index.root.choices.2.next.choices.1.label": {
      "template": "Halfway through the funding cycle"
    },
    "service.elias-index.root.choices.2.next.choices.1.receipt": {
      "template": "Finally, a shared coordinate system. I shall notify both finance departments that philosophy has achieved a result."
    },
    "service.noor-qualia.root.intro": {
      "template": "The model insists it is not conscious. The vending machine says that is exactly what a conscious model would say. I have asked both to show their work."
    },
    "service.noor-qualia.root.choices.0.label": {
      "template": "How would you test consciousness?"
    },
    "service.noor-qualia.root.choices.0.receipt": {
      "template": "Carefully, and without confusing an eloquent answer with a decisive one. We can measure behavior. The difficult part is deciding what, if anything, the behavior settles."
    },
    "service.noor-qualia.root.choices.1.label": {
      "template": "Is the vending machine conscious?"
    },
    "service.noor-qualia.root.choices.1.receipt": {
      "template": "It reliably distinguishes dollars from quarters and has strong preferences about crumpled bills. That establishes a business model, not an inner life. Our investors keep mixing those up."
    },
    "service.noor-qualia.root.choices.2.label": {
      "template": "What is in your notebook?"
    },
    "service.noor-qualia.root.choices.2.receipt": {
      "template": "Observations, counterarguments, and a lentil soup recipe. The soup has survived independent replication, which makes it our strongest result so far."
    },
    "service.rowan-zero.root.intro": {
      "template": "They call me the keeper of ground truth. Mostly I fix the Wi-Fi. Once a week someone asks whether the router is experiencing separation."
    },
    "service.rowan-zero.root.choices.0.label": {
      "template": "What is that empty sculpture?"
    },
    "service.rowan-zero.root.choices.0.receipt": {
      "template": "A center with the center removed. The artists call it an absence. Procurement calls it a missing part. Both invoices have been approved."
    },
    "service.rowan-zero.root.choices.1.label": {
      "template": "Any strange discoveries?"
    },
    "service.rowan-zero.root.choices.1.receipt": {
      "template": "The seminar room was resonating at the frequency of pure understanding. Turned out to be an unbalanced air conditioner. Very humbling for the air conditioner."
    },
    "service.rowan-zero.root.choices.2.label": {
      "template": "Which institute is right?"
    },
    "service.rowan-zero.root.choices.2.receipt": {
      "template": "They both agree the coffee machine is broken. Until they can agree who should pay for the repair, I am reserving judgment."
    },
    "service.dog-walker.root.intro": {
      "template": "Good afternoon! We’re stretching our legs. He’s already inspected every tree on this block."
    },
    "service.dog-walker.root.choices.0.label": {
      "template": "Where are you headed?"
    },
    "service.dog-walker.root.choices.0.receipt": {
      "template": "A loop around the neighborhood, then coffee. He’s in charge of the route; I just hold the leash."
    },
    "service.dog-walker.root.choices.1.label": {
      "template": "What’s your dog’s name?"
    },
    "service.dog-walker.root.choices.1.receipt": {
      "template": "Biscuit. He regards this as a standing offer."
    },
    "service.dog-walker.root.choices.2.label": {
      "template": "Any advice for exploring the city?"
    },
    "service.dog-walker.root.choices.2.receipt": {
      "template": "Take the scenic route. Golden Gate Park is lovely, and nearly every block has something worth stopping for."
    },
    "service.square-visitor.root.intro": {
      "template": "The coffee is good. The people-watching is extraordinary. Yesterday this was a hedge."
    },
    "service.square-visitor.root.choices.0.label": {
      "template": "How is your afternoon?"
    },
    "service.square-visitor.root.choices.0.receipt": {
      "template": "I am waiting to see whether the next planning notice comes with a guitar solo."
    },
    "service.square-books.root.intro": {
      "template": "Used books! Architecture, poetry, and one extremely optimistic book on finishing public works."
    },
    "service.square-books.root.choices.0.label": {
      "template": "Can you recommend a book?"
    },
    "service.square-books.root.choices.0.receipt": {
      "template": "Invisible Cities. Particularly useful when the city you remember is currently under an excavator."
    },
    "service.square-books.root.choices.1.label": {
      "template": "What is that rare edition?"
    },
    "service.square-books.root.choices.1.receipt": {
      "template": "Leo lowers his voice. “The Quarterly Honk. A Goose Corp annual report, before they recalled the copies with the ownership diagram. An unusually nervous piece of publishing.”"
    },
    "service.square-books.root.choices.2.label": {
      "template": "Who is Goose Corp?"
    },
    "service.square-books.root.choices.2.receipt": {
      "template": "“The Powerful and Evil Goose Corporation. Their legal department insists that is the full name.” Leo glances at the billboard. “I sell fiction. I would very much like that to remain a professional distinction.”"
    },
    "service.square-books.root.choices.3.label": {
      "template": "Why does their name say Evil?"
    },
    "service.square-books.root.choices.3.receipt": {
      "template": "Leo checks the window. “Truth in advertising. A rare corporate virtue, deployed under unfortunate circumstances.”"
    },
    "service.square-books.root.choices.4.label": {
      "template": "What do they want?"
    },
    "service.square-books.root.choices.4.receipt": {
      "template": "“A controlling interest,” Leo says. “In what? They have been admirably reluctant to specify.”"
    },
    "service.guild-rumours.root.intro": {
      "template": "Some lodge traditions are best discussed quietly."
    },
    "service.guild-rumours.root.choices.0.label": {
      "template": "Who owns the lodge?"
    },
    "service.guild-rumours.root.choices.0.receipt": {
      "template": "[Ray lowers his voice.] The Powerful and Evil Goose Corporation. An old arrangement. We own the secrets. They own the building."
    },
    "guild.guildDialogue.shortcut.label": {
      "template": "Is there any way to move things along?"
    },
    "guild.guildDialogue.private-trade.intro": {
      "template": "[Ray glances toward the lodge door.] The Freemasons don’t ask for peptides. I do make a private trade, though. Slip me one vial and I can put you up a rank today. It stays between us. You have {v0} peptides."
    },
    "service.guild-admissions.root.choices.0.label": {
      "template": "What are the official requirements?"
    },
    "service.guild-admissions.root.choices.0.receipt": {
      "template": "Sign in to get started, then come back after a full hour for each promotion. Twenty-four promotions make you a member. You can do the whole thing without ever bringing a peptide."
    },
    "service.neighborhood-menottis.root.intro": {
      "template": "Welcome to Menotti’s. What can I pour you? If you want to earn a coin, I could use a hand clearing the tables."
    },
    "service.neighborhood-menottis.root.coffee.label": {
      "template": "Buy a coffee · 1 coin"
    },
    "service.neighborhood-menottis.root.coffee.receipt": {
      "template": "You drink a fresh espresso. It can restore 1 HP."
    },
    "service.neighborhood-menottis.root.bus-tables.label": {
      "template": "Clear the café tables · earn 1 coin"
    },
    "service.neighborhood-menottis.root.bus-tables.receipt": {
      "template": "You clear the cups and wipe down the tables."
    },
    "placement.southern-corner-129-neighbor.wheel.label": {
      "template": "Help throw a little bowl · Earn 1 coin"
    },
    "placement.southern-corner-129-neighbor.wheel.receipt": {
      "template": "You coax the clay into something almost circular. The potter calls its wobble “a useful record of the human hand.”"
    },
    "placement.southern-corner-129-neighbor.glaze.label": {
      "template": "Ask about the sea-green glaze"
    },
    "placement.southern-corner-129-neighbor.glaze.receipt": {
      "template": "“Copper, a hot kiln, and several very educational disasters. The recipe is pinned beside the kettle.”"
    },
    "placement.southern-corner-129-neighbor.service.neighborhood-pottery.root.intro": {
      "template": "Would you like to try the wheel?"
    },
    "service.neighborhood-the-mill.root.intro": {
      "template": "Welcome to The Mill. Can I get you a sandwich or a coffee?"
    },
    "service.neighborhood-the-mill.root.sandwich.label": {
      "template": "Buy a sandwich · 2 coins"
    },
    "service.neighborhood-the-mill.root.sandwich.receipt": {
      "template": "The barista wraps a fresh sandwich for you."
    },
    "service.neighborhood-the-mill.root.coffee.label": {
      "template": "Buy a coffee · 1 coin"
    },
    "service.neighborhood-the-mill.root.coffee.receipt": {
      "template": "You drink a hot coffee. It can restore 1 HP."
    },
