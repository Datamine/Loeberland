    "bolinas-cultist": {
      "id": "service.bolinas-cultist.root",
      "intro": "Afternoon. Good day for a walk. The geese usually come in around four. I count them from the porch. Most days I get the same number.",
      "choices": [
        {
          "id": "service.bolinas-cultist.count",
          "label": "What happens when the count is off?",
          "receipt": "I count again. Last Tuesday, eleven went out and twelve came back. The extra one looked right at my window. Wait. Who told you to ask about the count? I have nothing to tell you.",
          "action": "confront"
        },
        {
          "id": "service.bolinas-cultist.cottage",
          "label": "Is that your cottage?",
          "receipt": "Has been for years. The geese used to walk straight past it. Lately one stops at the gate, right where you’re standing. Did somebody send you to ask about the house? I have nothing to tell you.",
          "action": "confront"
        }
      ]
    },
