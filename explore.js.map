      },
      "line-21": {
        "id": "line-21",
        "speaker": "npc",
        "text": "If I lose, let's say, 10 minutes a day on average to just logging into things, then that's what -- 3600 minutes a year?",
        "next": "line-22"
      },
      "line-22": {
        "id": "line-22",
        "speaker": "player",
        "text": "60 hours? That's crazy.",
        "end": true
      }
    }
  },
