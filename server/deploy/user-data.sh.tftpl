#!/usr/bin/env bash
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-buildx docker-compose-v2 openssl python3 cron curl unzip
if ! command -v aws >/dev/null; then
    aws_installer=$(mktemp -d)
    trap 'rm -rf -- "$aws_installer"' EXIT
    curl -fsSL --retry 3 https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o "$aws_installer/awscliv2.zip"
    unzip -q "$aws_installer/awscliv2.zip" -d "$aws_installer"
    "$aws_installer/aws/install"
    rm -rf -- "$aws_installer"
    trap - EXIT
fi
systemctl enable --now docker cron
if snap list amazon-ssm-agent >/dev/null 2>&1; then snap start amazon-ssm-agent; fi
install -d -m 700 /etc/loeberland /var/lib/loeberland/backups /opt/loeberland/releases

if [[ ! -s /etc/loeberland/admin.env ]]; then
    printf 'ADMIN_USERNAME=admin\nADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)" > /etc/loeberland/admin.env
fi
cat > /etc/loeberland/backup.env <<'ENV'
export COMPOSE_ENV_FILE=/opt/loeberland/current/compose.env
export S3_BACKUP_URI=s3://${bucket}/backups
export AWS_DEFAULT_REGION=${region}
ENV

cat > /usr/local/sbin/loeberland-deploy <<'DEPLOY'
#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 8>/var/lock/loeberland-deploy.lock
flock -n 8 || { echo 'A deployment is already running.' >&2; exit 1; }
digest=$${1:-}
[[ $digest =~ ^[a-f0-9]{64}$ ]] || { echo 'Supply a release SHA-256 digest.' >&2; exit 2; }
release=$(mktemp -d /opt/loeberland/releases/release-XXXXXXXX)
cat > "$release/compose.env"
test -s "$release/compose.env"
aws s3 cp "s3://${bucket}/releases/$digest.tar.gz" "$release/game.tar.gz" --region '${region}' --only-show-errors
printf '%s  %s\n' "$digest" "$release/game.tar.gz" | sha256sum -c --status
tar -xzf "$release/game.tar.gz" -C "$release"
exec bash "$release/sf/server/deploy/install-release.sh" "$release" "$digest"
DEPLOY
chmod 755 /usr/local/sbin/loeberland-deploy
