  "tweet_2018247911847678378_1": {
    "id": "tweet_2018247911847678378_1",
    "title": "The Epstein/Gates saga has a funny lesson for utilitarians.",
    "source_directory": "source-tweets",
    "source_files": ["2018247911847678378.txt"],
    "start": "line-1",
    "nodes": {
      "line-1": {
        "id": "line-1",
        "speaker": "npc",
        "text": "The Epstein/Gates saga has a funny lesson for utilitarians.",
        "next": "line-2"
      },
      "line-2": {
        "id": "line-2",
        "speaker": "npc",
        "text": "Gates has given more money to charity than anyone alive, and personally accounts for saving 80M+ lives.",
        "next": "line-3"
      },
      "line-3": {
        "id": "line-3",
        "speaker": "npc",
        "text": "Yet this has never done anything for him, or the perception of his ethics.",
        "next": "line-4"
      },
      "line-4": {
        "id": "line-4",
        "speaker": "player",
        "text": "The public hates him all the same.",
        "next": "line-5"
      },
      "line-5": {
        "id": "line-5",
        "speaker": "player",
        "text": "To the average news reader, his legacy right now looks to be \"the guy who gave his wife an std from a prostitute and tried to surreptitiously sneak her the meds.\"",
        "next": "line-6"
      },
      "line-6": {
        "id": "line-6",
        "speaker": "npc",
        "text": "Make of this what you will.",
        "end": true
      }
    }
  },
