{
  "goose_corp_1": {
    "id": "goose_corp_1",
    "title": "The landlord above the landlord",
    "tags": ["goose-corp", "rumours"],
    "start": "start",
    "nodes": {
      "start": {
        "speaker": "npc",
        "text": "Keep your voice down. That goose on the billboard? My landlord reports to it.",
        "choices": [
          {
            "id": "start.choice-1",
            "text": "Who is behind all this?",
            "next": "company"
          },
          {
            "id": "start.choice-2",
            "text": "Where can I learn more?",
            "next": "reading"
          },
          {
            "id": "start.choice-3",
            "text": "I should get going.",
            "next": "leave"
          }
        ],
        "id": "start"
      },
      "company": {
        "speaker": "npc",
        "text": "The Powerful and Evil Goose Corporation. Their legal department insists that is the full name. Please keep your voice down. They own the walls.",
        "choices": [
          {
            "id": "company.choice-1",
            "text": "Why put Evil in the name?",
            "next": "branding"
          },
          {
            "id": "company.choice-2",
            "text": "What do they actually own?",
            "next": "ownership"
          }
        ],
        "id": "company"
      },
      "reading": {
        "speaker": "npc",
        "text": "Ask Leo about The Quarterly Honk, or Ray about who owns the lodge. Some houses have books on ponds and executive waterfowl. Read carefully. Quietly.",
        "end": true,
        "id": "reading"
      },
      "leave": {
        "speaker": "npc",
        "text": "Of course. Walk casually. Do not make eye contact with the billboard.",
        "end": true,
        "id": "leave"
      },
      "branding": {
        "speaker": "npc",
        "text": "The branding consultant proposed leaving it implied. The board said that lacked ambition. The consultant now works in a pond.",
        "end": true,
        "id": "branding"
      },
      "ownership": {
        "speaker": "npc",
        "text": "The pond, the company that owns the pond, and the company investigating who owns the pond. The bread budget is the only part anyone can audit.",
        "end": true,
        "id": "ownership"
      }
    }
  },
