{
  "conversations": {
    "square-books": {
      "intro": "Used books! Architecture, poetry, and one extremely optimistic book on finishing public works.",
      "repeat": true,
      "choices": [
        {
          "label": "Can you recommend a book?",
          "receipt": "Invisible Cities. Particularly useful when the city you remember is currently under an excavator."
        },
        {
          "label": "What is that rare edition?",
          "receipt": "Leo lowers his voice. “The Quarterly Honk. A Goose Corp annual report, before they recalled the copies with the ownership diagram. An unusually nervous piece of publishing.”"
        },
        {
          "label": "Who is Goose Corp?",
          "receipt": "“The Powerful and Evil Goose Corporation. Their legal department insists that is the full name.” Leo glances at the billboard. “I sell fiction. I would very much like that to remain a professional distinction.”"
        },
        {
          "label": "Why does their name say Evil?",
          "receipt": "Leo checks the window. “Truth in advertising. A rare corporate virtue, deployed under unfortunate circumstances.”"
        },
        {
          "label": "What do they want?",
          "receipt": "“A controlling interest,” Leo says. “In what? They have been admirably reluctant to specify.”"
        }
      ]
    },
    "guild-rumours": {
      "intro": "Some lodge traditions are best discussed quietly.",
      "choices": [
        {
          "label": "Who owns the lodge?",
          "receipt": "Ray lowers his voice. “The Powerful and Evil Goose Corporation. An old arrangement. We own the secrets; they own the building.”"
        }
      ]
    }
  },
  "ambient": [
    {
      "id": "goose_corp_1",
      "title": "The landlord above the landlord",
      "tags": ["goose-corp", "rumours"],
      "start": "start",
      "nodes": {
        "start": {
          "speaker": "npc",
          "text": "Keep your voice down. That goose on the billboard? My landlord reports to it.",
          "choices": [
            {
              "text": "Who is behind all this?",
              "next": "company"
            },
            {
              "text": "Where can I learn more?",
              "next": "reading"
            },
            {
              "text": "I should get going.",
              "next": "leave"
            }
          ]
        },
        "company": {
          "speaker": "npc",
          "text": "The Powerful and Evil Goose Corporation. Their legal department insists that is the full name. Please keep your voice down. They own the walls.",
          "choices": [
            {
              "text": "Why put Evil in the name?",
              "next": "branding"
            },
            {
              "text": "What do they actually own?",
              "next": "ownership"
            }
          ]
        },
        "reading": {
          "speaker": "npc",
          "text": "Ask Leo about The Quarterly Honk, or Ray about who owns the lodge. Some houses have books on ponds and executive waterfowl. Read carefully. Quietly.",
          "end": true
        },
        "leave": {
          "speaker": "npc",
          "text": "Of course. Walk casually. Do not make eye contact with the billboard.",
          "end": true
        },
        "branding": {
          "speaker": "npc",
          "text": "The branding consultant proposed leaving it implied. The board said that lacked ambition. The consultant now works in a pond.",
          "end": true
        },
        "ownership": {
          "speaker": "npc",
          "text": "The pond, the company that owns the pond, and the company investigating who owns the pond. The bread budget is the only part anyone can audit.",
          "end": true
        }
      }
    },
