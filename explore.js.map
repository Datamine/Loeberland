  "tweet_2063386446728462693_1": {
    "id": "tweet_2063386446728462693_1",
    "title": "The other day I ordered an Uber. It said it was \"5 minutes away\".",
    "source_directory": "source-tweets",
    "source_files": ["2063386446728462693.txt"],
    "start": "line-1",
    "nodes": {
      "line-1": {
        "id": "line-1",
        "speaker": "npc",
        "text": "The other day I ordered an Uber. It said it was \"5 minutes away\".",
        "next": "line-2"
      },
      "line-2": {
        "id": "line-2",
        "speaker": "player",
        "text": "Was it five minutes away?",
        "next": "line-3"
      },
      "line-3": {
        "id": "line-3",
        "speaker": "npc",
        "text": "It said \"finding your driver\" for a while and then \"Pickup in 7 minutes.\"",
        "next": "line-4"
      },
      "line-4": { "id": "line-4", "speaker": "player", "text": "Of course.", "next": "line-5" },
      "line-5": {
        "id": "line-5",
        "speaker": "npc",
        "text": "And then I opened my timer. A full 9 minutes and 21 seconds later, it arrived.",
        "next": "line-6"
      },
      "line-6": {
        "id": "line-6",
        "speaker": "player",
        "text": "That is so tedious.",
        "next": "line-7"
      },
      "line-7": {
        "id": "line-7",
        "speaker": "npc",
        "text": "I hate being deceived at the margin.",
        "end": true
      }
    }
  },
  "tweet_2066804703921393850_1": {
    "id": "tweet_2066804703921393850_1",
    "title": "Recruiters have picked up on that \"out of distribution\" is the cool new term,...",
    "source_directory": "source-tweets",
    "source_files": ["2066804703921393850.txt"],
    "start": "line-1",
    "nodes": {
      "line-1": {
        "id": "line-1",
        "speaker": "npc",
        "text": "Recruiters have picked up on that \"out of distribution\" is the cool new term, much better than \"cracked\".",
        "next": "line-2"
      },
      "line-2": {
