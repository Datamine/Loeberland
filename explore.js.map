      "nodes": {
        "service.phone-shop.root": {
          "id": "service.phone-shop.root",
          "choices": [
            {
              "id": "service.phone-shop.root.choices.0",
              "label": {
                "text": "service.phone-shop.root.choices.0.label"
              },
              "action": "service.phone-shop.buy:[]"
            },
            {
              "id": "service.phone-shop.root.topic.earnings",
              "label": "What does the phone do?",
              "receipt": "Keep it equipped and some of your earnings get a lift. The idea was to let you do a little business wherever you happen to be. We had rather more success than we expected getting people to keep it in their hand."
            },
            {
              "id": "service.phone-shop.root.topic.attention",
              "label": "Is there a catch?",
              "receipt": "I find myself looking at the screen before I remember why I took it out. After a while, doomscrolling costs hitpoints. You can put the phone away from your character controls and bring it out again whenever you like."
            },
            {
              "id": "service.phone-shop.root.topic.campus",
              "label": "Why is the campus round?",
              "receipt": "I used to get to the end of a hallway and turn back toward my desk. Here I keep walking. You get a good look at the courtyard that way, if you remember to look up."
            }
          ],
          "repeat": false,
          "skipIntro": false,
          "intro": {
            "text": "service.phone-shop.root.intro"
          },
