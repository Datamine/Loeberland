    "nodes": {
      "line-72": {
        "id": "line-72",
        "speaker": "npc",
        "text": "There are two types of video games: those with increasing difficulty, and those with constant difficulty, but more stuff, as you proceed.",
        "next": "line-73"
      },
      "line-73": {
        "id": "line-73",
        "speaker": "npc",
        "text": "The former is played for achievement and fun, the latter is a numbing agent.",
