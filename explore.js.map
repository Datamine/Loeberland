    "pond-deeds": {
      "title": "On the Ownership of Ponds",
      "color": "#496b64",
      "subtitle": "A slim volume with a surprisingly extensive legal appendix.",
      "paragraphs": [
        "The pond belongs to the park. The water belongs to the city. The reflection belongs to a holding company registered in a jurisdiction with no known landmass.",
        "The author recommends reading any document before feeding it breadcrumbs. In the most recent edition, this advice has been struck out.",
        "An ownership diagram unfolds from the back cover. Every arrow leads to the same small drawing of a goose. Beneath it: The Powerful and Evil Goose Corporation. The word “Evil” has been underlined by a previous reader."
      ]
    },
    "executive-waterfowl": {
      "title": "A Field Guide to Executive Waterfowl",
      "color": "#a3614c",
      "subtitle": "The dust jacket promises an indispensable companion for the modern naturalist.",
      "paragraphs": [
        "The ordinary goose defends a patch of grass. The executive goose defends a diversified portfolio of patches of grass.",
        "If approached, remain calm. Do not make eye contact with its quarterly guidance. Do not run: it has already acquired the pavement.",
        "The chapter on distinguishing a honk from a binding tender offer has been carefully removed. A pencilled note reads: “Ask at the lodge. Quietly.”"
      ]
    },
    "quarterly-honk": {
      "title": "The Quarterly Honk",
      "color": "#444b79",
      "subtitle": "A household magazine, addressed to “The Current Beneficial Occupant”.",
      "paragraphs": [
        "Dear stakeholder: thank you for your continued presence in our addressable habitat. Your local pond has exceeded expectations.",
        "Our subsidiaries now include Anser Analytics, a property management company, and a company that owns the idea of walking away briskly. We remain committed to long-term pursuit.",
        "A photograph shows an empty boardroom. Every chair has been nibbled at precisely the same height. The caption reads: “Management is delighted.”"
      ]
    },
    "lodge-minutes": {
      "title": "Minutes of the Lodge Committee",
      "color": "#793c40",
      "subtitle": "A red ledger records the lodge’s more discreet arrangements.",
      "paragraphs": [
        "Motion 1: renew the lodge lease. Carried unanimously, apart from an unusually forceful honk from the empty chair.",
        "Motion 2: thank our discreet benefactor, the Powerful and Evil Goose Corporation. The secretary asks whether “Evil” is strictly necessary in the minutes. The motion to omit it is defeated.",
        "Motion 3: remove the pond from the balance sheet. Deferred. The pond is apparently our balance sheet.",
        "The final page is blank except for a webbed footprint and the instruction: “Please do not discuss the parent company. The walls are company property.”"
      ]
    }
