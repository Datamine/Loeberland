    "growth-capital": {
      "intro": {
        "text": "service.growth-capital.root.intro"
      },
      "repeat": true,
      "id": "service.growth-capital.root",
      "choices": [
        {
          "id": "service.growth-capital.root.topic.private-shares",
          "label": "What am I buying?",
          "receipt": "Growth equity is a stake in a company that’s moved past the early startup stage. The stake is private when you buy it here, so there’s no public price to check yet. If you’ve bought little startup shares elsewhere, those are a different thing.",
          "repeat": true
        },
        {
          "id": "service.growth-capital.root.topic.public-listing",
          "label": "What does taking it public mean?",
          "receipt": "The stockbroker in Times Square can put the stake on the public market. After that, the quote moves with what buyers are willing to pay. People come up here asking what they’ll make on the sale. I can tell them what the shares cost today. The rest is up to the market.",
          "repeat": true
        }
      ]
    },
