  "tweet_2020276679244148906_9": {
    "id": "tweet_2020276679244148906_9",
    "title": "\"Culture as food\" is an incredibly shallow view.",
    "source_directory": "source-tweets",
    "source_files": ["2020276679244148906.txt"],
    "start": "line-27",
    "nodes": {
      "line-27": {
        "id": "line-27",
        "speaker": "npc",
        "text": "\"Culture as food\" is an incredibly shallow view.",
        "next": "line-28"
      },
      "line-28": {
        "id": "line-28",
        "speaker": "npc",
        "text": "You mention any country, culture, ethnic group, etc. and the default response is \"Have you tried the [starch with meat]?\"",
        "next": "line-29"
      },
      "line-29": {
        "id": "line-29",
        "speaker": "player",
        "text": "Or, for example, there are lots of good reasons to be pro-immigration, but \"so I can have more [foreign vegetable soup] at low prices\" is not one of them.",
        "next": "line-30"
      },
      "line-30": {
        "id": "line-30",
        "speaker": "npc",
        "text": "Cultures are more than just their culinary products, and reducing them to that feels deeply unsatisfying.",
        "end": true
      }
    }
  },
  "tweet_2020276679244148906_10": {
    "id": "tweet_2020276679244148906_10",
    "title": "The irony of \"security questions\" on any given online service is that they te...",
    "source_directory": "source-tweets",
    "source_files": ["2020276679244148906.txt"],
