      "placements": ["actor:twitter-poster"],
      "root": "poster-reply",
      "nodes": {
        "poster-reply": {
          "id": "poster-reply",
          "intro": "Hang on. Someone is wrong on the internet, and I’ve just spent ten minutes finding a much nicer way to say so. Welcome to Posting HQ. Most of us meant to leave five minutes ago.",
          "question": "",
          "decline": "",
          "repeat": true,
          "skipIntro": false,
          "choices": [
            {
              "id": "poster-reply.topic.posting",
              "label": "What are you posting about?",
              "receipt": "A man said nobody walks anywhere in San Francisco. I walked here to write a reply. By the time I’d finished, he’d changed the subject to parking, so I think we both learned something."
            },
            {
              "id": "poster-reply.topic.workday",
              "label": "Is it always this busy?",
              "receipt": "It gets quiet around lunch. You can hear the chairs creak while everyone tries to think of a good opening line. Then somebody posts a photograph of a sandwich and we remember how to be neighbors."
            }
          ]
        }
      }
    },
